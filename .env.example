# E-Government PKI System - Environment Configuration
# Copy this file to .env and update the values

# ===========================================
# Django Settings
# ===========================================
DEBUG=True
SECRET_KEY=change-this-to-a-very-long-random-string-in-production

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# Database Settings
# ===========================================
DB_NAME=chinhquyendt
DB_USER=pnthanh
DB_PASSWORD=pnthanh2001
DB_HOST=db
DB_PORT=5432

# Full database URL (alternative to individual settings)
# DATABASE_URL=postgresql://pnthanh:pnthanh2001@db:5432/chinhquyendt

# ===========================================
# Email Settings (Gmail)
# ===========================================
# For Gmail: Enable 2FA, then create an App Password
# https://myaccount.google.com/apppasswords

EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ===========================================
# PKI Configuration
# ===========================================
# CRITICAL: Change this in production!
# Must be exactly 32 bytes for AES-256 encryption
PKI_MASTER_KEY=CHANGE_THIS_IN_PRODUCTION_32_BYTES!!

# Default post-quantum algorithm
PKI_DEFAULT_PQ_ALGORITHM=DILITHIUM3

# Require both classical and PQ signatures
PKI_REQUIRE_HYBRID_SIGNATURES=True

# Certificate validity periods (days)
PKI_ROOT_CA_VALIDITY=3650
PKI_INTERMEDIATE_CA_VALIDITY=1825
PKI_USER_CERT_VALIDITY=365
PKI_OFFICER_CERT_VALIDITY=730

# CRL settings
PKI_CRL_VALIDITY_DAYS=7

# ===========================================
# Frontend Settings
# ===========================================
# API URL for frontend to connect to backend
REACT_APP_API_URL=http://localhost:8000/api

# ===========================================
# Optional: Redis Settings (for caching)
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# Optional: Sentry (Error Tracking)
# ===========================================
# SENTRY_DSN=https://your-sentry-dsn

# ===========================================
# Production Only Settings
# ===========================================
# Uncomment and set these for production deployment

# HTTPS enforcement
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# HSTS settings
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
